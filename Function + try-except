def deposit(money):
  try:
      amount = float(input("Enter deposit amount: "))
      if amount <= 0:
          raise valueError("Deposit amount must be greater than 0")
  except ValueError as e:
      print(f"Error: {e}")
  else:
      money += amount
      print("Deposit successful")
      print(f"Remaining balance: {money:.2f} baht")
  finally:
      print("End of deposit transaction")

  return money

